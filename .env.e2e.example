# Used only by `npm run test:e2e` / `npm run cy:open` (copy to .env.e2e).
# A separate database: Cypress wipes it before every test.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/physio_e2e"
AUTH_SECRET="e2e-only-secret-not-for-production"
# Enables /api/test/* and the controllable server clock. Never set this in production.
E2E_TEST_MODE="1"
E2E_TEST_SECRET="local-e2e-secret"
