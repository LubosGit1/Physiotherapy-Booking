{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["cypress", "cypress-axe", "@testing-library/cypress", "node"]
  },
  "include": ["**/*.ts", "../cypress.config.ts"]
}
